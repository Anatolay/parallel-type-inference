Prog. Program ::= [Stm] ;

Fun. Function ::= "fn" Ident "(" [Ident] ")" "{" [Stm] "}" ;

terminator Stm "" ;
separator Ident "," ;

SAss.    Stm ::= Ident "=" Exp ;
SEpx.    Stm ::= Exp ";" ;
SFunDef. Stm ::= Function ;
SWhile.  Stm ::= "while" "(" Exp ")" "{" [Stm] "}" ;
SReturn. Stm ::= "return" Exp ";" ;


ELt.   Exp  ::= Exp1 "<"  Exp1 ;
EGt.   Exp  ::= Exp1 ">"  Exp1 ;
EEq.   Exp  ::= Exp1 "==" Exp1 ;
EAdd.  Exp1 ::= Exp1 "+"  Exp2 ;
ESub.  Exp1 ::= Exp  "-"  Exp1 ;
EMul.  Exp2 ::= Exp2 "*"  Exp3 ;
EDiv.  Exp2 ::= Exp2 "/"  Exp3 ;
ECall. Exp3 ::= Ident "(" [Exp] ")" ;
EVar.  Exp3 ::= Ident ;
EInt.  Exp3 ::= Integer ;
EStr.  Exp3 ::= String ;

coercions Exp 3 ;
separator Exp "," ;

Prog. Program ::= [Exp] ;

terminator Exp ";" ;

Lambda. Exp ::= "λ" Ident "." Exp ;
Succ.   Exp ::= "succ" Exp ;
Pred.   Exp ::= "pred" Exp ;
Cond.   Exp ::= "if" Exp "then" Exp "else" Exp ;
Let.    Exp ::= "let" Ident "=" Exp "in" Exp ;
Appl.   Exp1 ::= Exp Exp1 ;
Zero.   Exp2 ::= "0" ;
Var.    Exp2 ::= Ident ;

coercions Exp 3 ;
